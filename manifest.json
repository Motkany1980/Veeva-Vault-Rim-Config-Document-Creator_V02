{
  "manifest_version": 3,
  "name": "Veeva Vault RIM Config Documenter",
  "version": "1.0.0",
  "description": "Automatic configuration documentation & screenshot generator (.docx) for Veeva Vault RIM with SSID authentication and 0/1/2 + Left Click hotkeys.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "sidePanel",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "*://*.veevavault.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Veeva Vault RIM Config Documenter"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
